{
  "runtime": "native-v1",
  "name": "Apparence des fenêtres",
  "description": "Profils clairs et sombres, cadres dégradés, titres, ombres et règles par application pour Windows.",
  "version": "0.1.0",
  "deviceSettingsVersion": "1",
  "settings": [
    {
      "id": "general",
      "type": "section",
      "label": "Commencer",
      "description": "Choisissez un profil et les applications à habiller.",
      "defaultCollapsed": false
    },
    {
      "id": "enabled",
      "type": "boolean",
      "label": "Activer l’apparence des fenêtres",
      "default": true,
      "scope": "device",
      "parent": "general"
    },
    {
      "id": "profile",
      "type": "select",
      "label": "Profil visuel",
      "default": "nocturne",
      "scope": "device",
      "parent": "general",
      "options": [
        {
          "value": "system",
          "label": "Windows"
        },
        {
          "value": "porcelain",
          "label": "Porcelaine"
        },
        {
          "value": "nocturne",
          "label": "Nocturne"
        },
        {
          "value": "aurora",
          "label": "Aurore"
        },
        {
          "value": "ember",
          "label": "Braise"
        },
        {
          "value": "graphite",
          "label": "Graphite"
        },
        {
          "value": "frost",
          "label": "Givre"
        },
        {
          "value": "custom",
          "label": "Personnalisé"
        }
      ],
      "description": "Les profils règlent les couleurs et la décoration. Personnalisé déverrouille tous les détails."
    },
    {
      "id": "targetApps",
      "type": "textarea",
      "label": "Applications choisies",
      "default": "notepad.exe",
      "scope": "device",
      "parent": "general",
      "description": "Un nom d’application par ligne, par exemple notepad.exe ou code.exe. Une liste vide ne modifie aucune application."
    },
    {
      "id": "excludedApps",
      "type": "textarea",
      "label": "Applications à préserver",
      "default": "",
      "scope": "device",
      "parent": "general",
      "description": "Un nom par ligne. Ces exclusions prennent toujours le dessus."
    },
    {
      "id": "includeDialogs",
      "type": "boolean",
      "label": "Inclure les fenêtres de dialogue",
      "default": false,
      "scope": "device",
      "parent": "general",
      "description": "Habille aussi les dialogues appartenant aux applications choisies."
    },
    {
      "id": "monitor",
      "type": "select",
      "label": "Écrans concernés",
      "default": "all",
      "scope": "device",
      "parent": "general",
      "options": [
        {
          "value": "all",
          "label": "Tous les écrans"
        },
        {
          "value": "primary",
          "label": "Écran principal"
        },
        {
          "value": "secondary",
          "label": "Autres écrans"
        }
      ]
    },
    {
      "id": "theme",
      "type": "select",
      "label": "Ambiance",
      "default": "auto",
      "scope": "device",
      "parent": "general",
      "options": [
        {
          "value": "auto",
          "label": "Suivre le thème Windows"
        },
        {
          "value": "dark",
          "label": "Sombre"
        },
        {
          "value": "light",
          "label": "Claire"
        }
      ],
      "description": "Les profils disposent de palettes claires et sombres. Les couleurs personnalisées restent celles que vous choisissez."
    },
    {
      "id": "materialSection",
      "type": "section",
      "label": "Matériau et transparence",
      "description": "Le matériau natif dépend de Windows et du rendu de l’application.",
      "defaultCollapsed": false
    },
    {
      "id": "nativeMaterial",
      "type": "select",
      "label": "Matériau Windows",
      "default": "mica",
      "scope": "device",
      "parent": "materialSection",
      "options": [
        {
          "value": "system",
          "label": "Conserver celui de l’application"
        },
        {
          "value": "opaque",
          "label": "Opaque"
        },
        {
          "value": "mica",
          "label": "Mica · teinté par le fond"
        },
        {
          "value": "acrylic",
          "label": "Acrylique · verre flouté"
        },
        {
          "value": "tabbed",
          "label": "Mica profond"
        }
      ],
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      },
      "description": "Mica et acrylique exigent Windows 11 22621 ou ultérieur. Le contenu opaque d’une application peut les masquer."
    },
    {
      "id": "nativeColors",
      "type": "boolean",
      "label": "Colorer le cadre natif",
      "default": true,
      "scope": "device",
      "parent": "materialSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "restoreNativeDefaults",
      "type": "boolean",
      "label": "Appliquer les effets natifs non relisibles",
      "default": false,
      "scope": "device",
      "parent": "materialSection",
      "description": "Windows ne permet pas de relire certains attributs. Si activé, leurs couleurs, thème et coins reviennent aux valeurs Windows à l’arrêt, sans garantie de retrouver un style antérieur de l’application. Sinon ils sont préservés."
    },
    {
      "id": "windowOpacity",
      "type": "range",
      "label": "Opacité de la fenêtre (%)",
      "default": 100,
      "scope": "device",
      "parent": "materialSection",
      "min": 35,
      "max": 100,
      "step": 1,
      "description": "Affecte aussi le contenu. Les fenêtres déjà gérées par un autre moteur de transparence sont préservées."
    },
    {
      "id": "inactiveOpacity",
      "type": "range",
      "label": "Opacité à l’arrière-plan (%)",
      "default": 100,
      "scope": "device",
      "parent": "materialSection",
      "min": 35,
      "max": 100,
      "step": 1,
      "description": "La fenêtre active retrouve son opacité de premier plan."
    },
    {
      "id": "preserveMaximized",
      "type": "boolean",
      "label": "Préserver les coins en plein écran et maximisés",
      "default": true,
      "scope": "device",
      "parent": "materialSection",
      "description": "Suspend les découpes de coins et les ombres supplémentaires quand elles gênent les bords de l’écran."
    },
    {
      "id": "borderSection",
      "type": "section",
      "label": "Contours et coins",
      "description": "Un liseré discret ou un cadre expressif.",
      "defaultCollapsed": false,
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "borderMode",
      "type": "select",
      "label": "Bordure",
      "default": "solid",
      "scope": "device",
      "parent": "borderSection",
      "options": [
        {
          "value": "system",
          "label": "Windows"
        },
        {
          "value": "none",
          "label": "Masquer le contour natif"
        },
        {
          "value": "solid",
          "label": "Couleur unie"
        },
        {
          "value": "gradient",
          "label": "Dégradé"
        }
      ],
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "borderWidth",
      "type": "range",
      "label": "Épaisseur du liseré ajouté (px)",
      "default": 2,
      "scope": "device",
      "parent": "borderSection",
      "min": 0,
      "max": 12,
      "step": 1,
      "description": "Le liseré est dessiné à l’extérieur. Il ne réduit pas la zone utilisable.",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "borderColor",
      "type": "color",
      "label": "Bordure active",
      "default": "#6889E8",
      "scope": "device",
      "parent": "borderSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "borderEnd",
      "type": "color",
      "label": "Bordure · couleur d’arrivée",
      "default": "#8DCDE7",
      "scope": "device",
      "parent": "borderSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      },
      "description": "Couleur d’arrivée du dégradé du liseré."
    },
    {
      "id": "inactiveBorder",
      "type": "color",
      "label": "Bordure inactive",
      "default": "#354461",
      "scope": "device",
      "parent": "borderSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "gradientDirection",
      "type": "select",
      "label": "Direction des dégradés",
      "default": "horizontal",
      "scope": "device",
      "parent": "borderSection",
      "options": [
        {
          "value": "horizontal",
          "label": "De gauche à droite"
        },
        {
          "value": "vertical",
          "label": "Du haut vers le bas"
        },
        {
          "value": "diagonal",
          "label": "En diagonale"
        }
      ],
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "corner",
      "type": "select",
      "label": "Forme des coins",
      "default": "round",
      "scope": "device",
      "parent": "borderSection",
      "options": [
        {
          "value": "system",
          "label": "Windows"
        },
        {
          "value": "square",
          "label": "Droits"
        },
        {
          "value": "small",
          "label": "Arrondis discrets"
        },
        {
          "value": "round",
          "label": "Arrondis Windows"
        },
        {
          "value": "custom",
          "label": "Rayon précis · découpe de fenêtre"
        }
      ],
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "cornerRadius",
      "type": "range",
      "label": "Rayon de la découpe (px)",
      "default": 16,
      "scope": "device",
      "parent": "borderSection",
      "min": 0,
      "max": 48,
      "step": 1,
      "description": "La découpe peut rogner les coins du contenu. Elle remplace temporairement la région de fenêtre.",
      "showIf": {
        "setting": "corner",
        "equals": "custom"
      }
    },
    {
      "id": "titleSection",
      "type": "section",
      "label": "Barre de titre",
      "description": "Le titre compagnon se place au-dessus de la fenêtre, sans recouvrir son contenu.",
      "defaultCollapsed": false
    },
    {
      "id": "titleMode",
