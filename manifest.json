      "scope": "device",
      "parent": "titleSection",
      "options": [
        {
          "value": "native",
          "label": "Titre Windows / application"
        },
        {
          "value": "companion",
          "label": "Barre de titre compagnon"
        },
        {
          "value": "hidden",
          "label": "Masquer le titre Windows"
