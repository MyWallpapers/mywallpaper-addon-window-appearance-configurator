      }
    },
    {
      "id": "titleEnd",
      "type": "color",
      "label": "Titre · couleur d’arrivée",
      "default": "#253755",
      "scope": "device",
      "parent": "titleSection",
      "showIf": {
        "setting": "profile",
        "equals": "custom"
      }
    },
    {
      "id": "titleOpacity",
